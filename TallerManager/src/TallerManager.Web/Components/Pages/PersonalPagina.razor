@page "/personal"
@attribute [Authorize(Roles = "Administrador")]

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore
@using TallerManager.Domain.Entities
@using TallerManager.Infrastructure.Data

@inject IDbContextFactory<TallerManagerDbContext> DbFactory

<PageTitle>Personal</PageTitle>

<div class="flex flex-col md:flex-row md:items-center justify-between mb-xl gap-md">
    <div>
        <h2 class="font-display-lg text-display-lg text-on-surface mb-xs">Personal</h2>
        <p class="font-body-md text-body-md text-secondary">Empleados registrados en el taller.</p>
    </div>
    <button class="flex items-center gap-sm px-md py-2 bg-primary-container text-on-primary-container rounded-lg font-body-md text-body-md font-semibold hover:opacity-90 shadow-sm transition-opacity"
            @onclick="AbrirModalNuevo">
        <span class="material-symbols-outlined text-[20px]">badge</span>
        Nuevo Empleado
    </button>
</div>

<div class="bg-surface border border-outline-variant rounded-xl shadow-sm overflow-hidden flex flex-col">
    <div class="overflow-x-auto">
        @if (ListaPersonal is null)
        {
            <p class="p-lg text-body-md text-secondary">Cargando...</p>
        }
        else if (!ListaPersonal.Any())
        {
            <p class="p-lg text-body-md text-secondary">No hay personal registrado todavía.</p>
        }
        else
        {
            <table class="w-full text-left border-collapse">
                <thead class="bg-surface-container-low border-b border-outline-variant">
                    <tr>
                        <th class="px-lg py-sm font-label-caps text-label-caps text-secondary">Nombre</th>
                        <th class="px-lg py-sm font-label-caps text-label-caps text-secondary">Puesto</th>
                        <th class="px-lg py-sm font-label-caps text-label-caps text-secondary">Especialidad</th>
                        <th class="px-lg py-sm font-label-caps text-label-caps text-secondary">Teléfono</th>
                        <th class="px-lg py-sm font-label-caps text-label-caps text-secondary">Ingreso</th>
                        <th class="px-lg py-sm font-label-caps text-label-caps text-secondary">Usuario</th>
                        <th class="px-lg py-sm font-label-caps text-label-caps text-secondary">Estado</th>
                    </tr>
                </thead>
                <tbody class="font-body-md text-body-md text-on-surface divide-y divide-outline-variant">
                    @foreach (var p in ListaPersonal)
                    {
                        <tr class="hover:bg-surface-container-lowest transition-colors">
                            <td class="px-lg py-md font-semibold">@p.Nombre</td>
                            <td class="px-lg py-md text-on-surface-variant">@(p.Puesto ?? "—")</td>
                            <td class="px-lg py-md text-on-surface-variant">@(p.Especialidad ?? "—")</td>
                            <td class="px-lg py-md font-data-mono text-data-mono text-on-surface-variant">@(p.Telefono ?? "—")</td>
                            <td class="px-lg py-md font-data-mono text-data-mono text-on-surface-variant">@p.FechaIngreso.ToString("dd MMM yyyy")</td>
                            <td class="px-lg py-md text-on-surface-variant">@(p.Usuario?.Email ?? "Sin cuenta")</td>
                            <td class="px-lg py-md">
                                @if (p.Activo)
                                {
                                    <span class="inline-flex items-center gap-xs px-2 py-1 rounded-full bg-primary-fixed text-primary font-label-caps text-label-caps">
                                        <span class="w-1.5 h-1.5 rounded-full bg-primary"></span>
                                        ACTIVO
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center gap-xs px-2 py-1 rounded-full bg-surface-variant text-on-surface-variant font-label-caps text-label-caps">
                                        <span class="w-1.5 h-1.5 rounded-full bg-outline"></span>
                                        INACTIVO
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@if (MostrarModal)
{
    <div class="fixed inset-0 bg-inverse-surface/50 z-[100] flex items-center justify-center p-md">
        <div class="bg-surface rounded-xl shadow-lg w-full max-w-md flex flex-col">
            <div class="flex items-center justify-between px-lg py-md border-b border-outline-variant">
                <h2 class="font-headline-sm text-headline-sm text-on-surface">Nuevo empleado</h2>
                <button class="text-on-surface-variant hover:bg-surface-container rounded-full p-1 transition-colors" @onclick="CerrarModal">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>
            <EditForm Model="NuevoPersonal" OnValidSubmit="GuardarAsync">
                <DataAnnotationsValidator />
                <div class="px-lg py-md flex flex-col gap-md">
                    <div>
                        <label class="font-label-caps text-label-caps text-secondary block mb-xs">Nombre completo *</label>
                        <InputText class="w-full px-md py-2 bg-surface border border-outline-variant rounded-lg font-body-md text-body-md text-on-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary"
                                   @bind-Value="NuevoPersonal.Nombre" />
                        <ValidationMessage For="() => NuevoPersonal.Nombre" class="text-error text-body-sm mt-xs block" />
                    </div>
                    <div class="grid grid-cols-2 gap-md">
                        <div>
                            <label class="font-label-caps text-label-caps text-secondary block mb-xs">Puesto</label>
                            <InputText class="w-full px-md py-2 bg-surface border border-outline-variant rounded-lg font-body-md text-body-md text-on-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary"
                                       @bind-Value="NuevoPersonal.Puesto" />
                        </div>
                        <div>
                            <label class="font-label-caps text-label-caps text-secondary block mb-xs">Teléfono</label>
                            <InputText class="w-full px-md py-2 bg-surface border border-outline-variant rounded-lg font-body-md text-body-md text-on-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary"
                                       @bind-Value="NuevoPersonal.Telefono" />
                        </div>
                    </div>
                    <div>
                        <label class="font-label-caps text-label-caps text-secondary block mb-xs">Especialidad</label>
                        <InputText class="w-full px-md py-2 bg-surface border border-outline-variant rounded-lg font-body-md text-body-md text-on-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary"
                                   placeholder="Ej. Suspensión, frenos, motor..."
                                   @bind-Value="NuevoPersonal.Especialidad" />
                    </div>
                    <div>
                        <label class="font-label-caps text-label-caps text-secondary block mb-xs">Cuenta de usuario (opcional)</label>
                        <select class="w-full px-md py-2 bg-surface border border-outline-variant rounded-lg font-body-md text-body-md text-on-surface"
                                @bind="UsuarioIdSeleccionado">
                            <option value="">Sin cuenta asociada</option>
                            @if (UsuariosDisponibles is not null)
                            {
                                @foreach (var u in UsuariosDisponibles)
                                {
                                    <option value="@u.Id">@u.NombreCompleto (@u.Email)</option>
                                }
                            }
                        </select>
                    </div>
                </div>
                <div class="flex justify-end gap-sm px-lg py-md border-t border-outline-variant">
                    <button type="button" class="px-md py-2 rounded-lg font-body-md text-body-md text-on-surface-variant hover:bg-surface-container transition-colors" @onclick="CerrarModal">
                        Cancelar
                    </button>
                    <button type="submit" class="px-md py-2 bg-primary-container text-on-primary-container rounded-lg font-body-md text-body-md font-semibold hover:opacity-90 shadow-sm transition-opacity">
                        Guardar
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@code {
    private List<Personal>? ListaPersonal;
    private List<ApplicationUser>? UsuariosDisponibles;
    private string UsuarioIdSeleccionado = string.Empty;
    private bool MostrarModal = false;
    private Personal NuevoPersonal = new();

    protected override async Task OnInitializedAsync()
    {
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        ListaPersonal = await db.Personal
            .Include(p => p.Usuario)
            .Where(p => p.Activo)
            .OrderBy(p => p.Nombre)
            .ToListAsync();
    }

    private async Task AbrirModalNuevo()
    {
        NuevoPersonal = new Personal();
        UsuarioIdSeleccionado = string.Empty;

        await using var db = await DbFactory.CreateDbContextAsync();
        UsuariosDisponibles = await db.Users.OrderBy(u => u.NombreCompleto).ToListAsync();

        MostrarModal = true;
    }

    private void CerrarModal() => MostrarModal = false;

    private async Task GuardarAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        var taller = await db.Talleres.OrderBy(t => t.FechaCreacion).FirstOrDefaultAsync();
        if (taller is null) return;

        NuevoPersonal.TallerId = taller.Id;
        NuevoPersonal.UsuarioId = string.IsNullOrWhiteSpace(UsuarioIdSeleccionado) ? null : UsuarioIdSeleccionado;

        db.Personal.Add(NuevoPersonal);
        await db.SaveChangesAsync();

        MostrarModal = false;
        await CargarAsync();
    }
}