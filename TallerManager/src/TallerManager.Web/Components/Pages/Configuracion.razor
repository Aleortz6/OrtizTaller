@page "/configuracion"
@attribute [Authorize(Roles = "Administrador")]

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore
@using TallerManager.Domain.Entities
@using TallerManager.Infrastructure.Data

@inject IDbContextFactory<TallerManagerDbContext> DbFactory
@inject IWebHostEnvironment Environment

<PageTitle>Configuración</PageTitle>

<div class="mb-xl">
    <h1 class="font-display-lg text-display-lg text-on-surface mb-xs">Configuración</h1>
    <p class="font-body-md text-body-md text-secondary">Datos del taller, usuarios y personal.</p>
</div>

<ConfiguracionTabs />

@if (Taller is null)
{
    <p class="text-body-md text-secondary">Cargando...</p>
}
else
{
    <div class="grid grid-cols-1 xl:grid-cols-3 gap-lg">
        <div class="xl:col-span-2 bg-surface border border-outline-variant rounded-xl shadow-sm p-lg">
            <h2 class="font-headline-sm text-headline-sm text-on-surface mb-md">Datos del taller</h2>
            <div class="flex flex-col gap-md">
                <div>
                    <label class="font-label-caps text-label-caps text-secondary block mb-xs">Nombre comercial *</label>
                    <input class="w-full px-md py-2 bg-surface border border-outline-variant rounded-lg font-body-md text-body-md text-on-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary"
                           @bind="Taller.Nombre" @bind:event="oninput" />
                </div>
                <div>
                    <label class="font-label-caps text-label-caps text-secondary block mb-xs">Razón social</label>
                    <input class="w-full px-md py-2 bg-surface border border-outline-variant rounded-lg font-body-md text-body-md text-on-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary"
                           @bind="Taller.RazonSocial" @bind:event="oninput" />
                </div>
                <div class="grid grid-cols-2 gap-md">
                    <div>
                        <label class="font-label-caps text-label-caps text-secondary block mb-xs">Teléfono</label>
                        <input class="w-full px-md py-2 bg-surface border border-outline-variant rounded-lg font-body-md text-body-md text-on-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary"
                               @bind="Taller.Telefono" @bind:event="oninput" />
                    </div>
                    <div>
                        <label class="font-label-caps text-label-caps text-secondary block mb-xs">Correo</label>
                        <input class="w-full px-md py-2 bg-surface border border-outline-variant rounded-lg font-body-md text-body-md text-on-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary"
                               @bind="Taller.Email" @bind:event="oninput" />
                    </div>
                </div>
                <div>
                    <label class="font-label-caps text-label-caps text-secondary block mb-xs">Dirección</label>
                    <input class="w-full px-md py-2 bg-surface border border-outline-variant rounded-lg font-body-md text-body-md text-on-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary"
                           @bind="Taller.Direccion" @bind:event="oninput" />
                </div>
                <div>
                    <label class="font-label-caps text-label-caps text-secondary block mb-xs">Color principal de documentos</label>
                    <div class="flex items-center gap-md">
                        <input type="color" class="w-12 h-10 rounded-lg border border-outline-variant cursor-pointer"
                               @bind="Taller.ColorPrimario" @bind:event="oninput" />
                        <span class="font-data-mono text-data-mono text-on-surface-variant">@Taller.ColorPrimario</span>
                    </div>
                </div>
                <div>
                    <label class="font-label-caps text-label-caps text-secondary block mb-xs">Términos y condiciones (aparece al pie de la cotización)</label>
                    <textarea class="w-full px-md py-2 bg-surface border border-outline-variant rounded-lg font-body-md text-body-md text-on-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary min-h-[80px]"
                              @bind="Taller.TerminosLegales" @bind:event="oninput"></textarea>
                </div>

                @if (!string.IsNullOrWhiteSpace(Mensaje))
                {
                    <p class="@(EsError ? "text-error" : "text-primary") text-body-sm">@Mensaje</p>
                }

                <div class="flex justify-end">
                    <button class="px-lg py-2 bg-primary text-on-primary rounded-lg font-body-md text-body-md font-semibold hover:opacity-90 shadow-sm transition-opacity"
                            @onclick="GuardarAsync">
                        Guardar cambios
                    </button>
                </div>
            </div>
        </div>

        <div class="bg-surface border border-outline-variant rounded-xl shadow-sm p-lg">
            <h2 class="font-headline-sm text-headline-sm text-on-surface mb-md">Logo del taller</h2>
            <div class="flex flex-col items-center gap-md">
                @if (!string.IsNullOrWhiteSpace(Taller.LogoUrl))
                {
                    <img src="@Taller.LogoUrl" alt="Logo del taller" class="max-w-full max-h-32 object-contain border border-outline-variant rounded-lg p-sm" />
                }
                else
                {
                    <div class="w-full h-32 flex items-center justify-center bg-surface-container-low rounded-lg text-secondary">
                        <span class="material-symbols-outlined text-[40px]">image</span>
                    </div>
                }

                <InputFile OnChange="OnLogoSeleccionado" accept=".png,.jpg,.jpeg" class="text-body-sm" />
                <p class="text-body-sm text-secondary text-center">PNG o JPG, tamaño recomendado 300x300px.</p>

                @if (SubiendoLogo)
                {
                    <p class="text-body-sm text-primary">Subiendo logo...</p>
                }
            </div>
        </div>
    </div>
}

@code {
    private Taller? Taller;
    private string? Mensaje;
    private bool EsError;
    private bool SubiendoLogo;

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        Taller = await db.Talleres.OrderBy(t => t.FechaCreacion).FirstOrDefaultAsync();
    }

    private async Task GuardarAsync()
    {
        if (Taller is null) return;

        if (string.IsNullOrWhiteSpace(Taller.Nombre))
        {
            Mensaje = "El nombre comercial es obligatorio.";
            EsError = true;
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        db.Talleres.Update(Taller);
        await db.SaveChangesAsync();

        Mensaje = "Cambios guardados correctamente.";
        EsError = false;
    }

    private async Task OnLogoSeleccionado(InputFileChangeEventArgs e)
    {
        if (Taller is null) return;

        var archivo = e.File;
        if (archivo is null) return;

        if (archivo.Size > 2 * 1024 * 1024)
        {
            Mensaje = "El logo no debe pesar más de 2 MB.";
            EsError = true;
            return;
        }

        SubiendoLogo = true;
        Mensaje = null;

        try
        {
            var carpetaLogos = Path.Combine(Environment.WebRootPath, "uploads", "logos");
            Directory.CreateDirectory(carpetaLogos);

            var extension = Path.GetExtension(archivo.Name);
            var nombreArchivo = $"taller-{Taller.Id}{extension}";
            var rutaCompleta = Path.Combine(carpetaLogos, nombreArchivo);

            await using var stream = archivo.OpenReadStream(2 * 1024 * 1024);
            await using var fileStream = new FileStream(rutaCompleta, FileMode.Create);
            await stream.CopyToAsync(fileStream);

            Taller.LogoUrl = $"/uploads/logos/{nombreArchivo}?v={DateTime.UtcNow.Ticks}";

            await using var db = await DbFactory.CreateDbContextAsync();
            db.Talleres.Update(Taller);
            await db.SaveChangesAsync();

            Mensaje = "Logo actualizado correctamente.";
            EsError = false;
        }
        catch (Exception)
        {
            Mensaje = "Ocurrió un error al subir el logo.";
            EsError = true;
        }
        finally
        {
            SubiendoLogo = false;
        }
    }
}