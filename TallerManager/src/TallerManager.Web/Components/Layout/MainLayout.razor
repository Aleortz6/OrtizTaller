@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Nav

<div class="bg-background text-on-background font-body-md flex h-screen overflow-hidden antialiased">

    <!-- Sidebar -->
    <aside class="fixed left-0 top-0 h-full @(SidebarColapsado ? "w-sidebar-collapsed" : "w-sidebar-width") flex flex-col border-r border-outline-variant bg-background z-50 hidden md:flex transition-all duration-200 @(SidebarColapsado ? "is-collapsed" : "")">
        <div class="p-lg flex items-center gap-md border-b border-outline-variant">
            <button class="flex-shrink-0" @onclick="ToggleSidebar">
                <div class="w-10 h-10 rounded-lg bg-primary-container flex items-center justify-center text-on-primary-container shadow-sm hover:opacity-80 transition-opacity">
                    <span class="material-symbols-outlined">directions_car</span>
                </div>
            </button>
            <div class="flex flex-col sidebar-label">
                <span class="font-headline-sm text-headline-sm font-bold text-primary tracking-tight">TALLER MANAGER</span>
                <span class="font-label-caps text-label-caps text-secondary">Gestión Profesional</span>
            </div>
            <button class="ml-auto text-secondary hover:text-primary transition-colors sidebar-label" @onclick="ToggleSidebar">
                <span class="material-symbols-outlined">menu_open</span>
            </button>
        </div>

        <nav class="flex-1 overflow-y-auto py-md flex flex-col gap-xs px-sm">
            <NavLink class="flex items-center gap-md px-md py-sm rounded-lg hover:bg-surface-container transition-colors text-secondary font-body-md text-body-md"
                     ActiveClass="bg-surface-container text-primary font-bold border-l-4 border-primary" href="" Match="NavLinkMatch.All">
                <span class="material-symbols-outlined">home</span>
                <span class="sidebar-label">Inicio</span>
            </NavLink>

            <AuthorizeView Roles="Administrador,Secretaria">
                <Authorized>
                    <NavLink class="flex items-center gap-md px-md py-sm rounded-lg hover:bg-surface-container transition-colors text-secondary font-body-md text-body-md"
                             ActiveClass="bg-surface-container text-primary font-bold border-l-4 border-primary" href="clientes">
                        <span class="material-symbols-outlined">group</span>
                        <span class="sidebar-label">Clientes</span>
                    </NavLink>
                </Authorized>
            </AuthorizeView>

            <AuthorizeView Roles="Administrador,Secretaria,Mecanico">
                <Authorized>
                    <NavLink class="flex items-center gap-md px-md py-sm rounded-lg hover:bg-surface-container transition-colors text-secondary font-body-md text-body-md"
                             ActiveClass="bg-surface-container text-primary font-bold border-l-4 border-primary" href="vehiculos">
                        <span class="material-symbols-outlined">directions_car</span>
                        <span class="sidebar-label">Vehículos</span>
                    </NavLink>
                </Authorized>
            </AuthorizeView>

            <AuthorizeView Roles="Administrador,Secretaria,Mecanico">
                <Authorized>
                    <NavLink class="flex items-center gap-md px-md py-sm rounded-lg hover:bg-surface-container transition-colors text-secondary font-body-md text-body-md"
                             ActiveClass="bg-surface-container text-primary font-bold border-l-4 border-primary" href="ordenes">
                        <span class="material-symbols-outlined">build</span>
                        <span class="sidebar-label">Órdenes</span>
                    </NavLink>
                </Authorized>
            </AuthorizeView>

            <AuthorizeView Roles="Administrador,Secretaria">
                <Authorized>
                    <NavLink class="flex items-center gap-md px-md py-sm rounded-lg hover:bg-surface-container transition-colors text-secondary font-body-md text-body-md"
                             ActiveClass="bg-surface-container text-primary font-bold border-l-4 border-primary" href="inventario">
                        <span class="material-symbols-outlined">inventory_2</span>
                        <span class="sidebar-label">Inventario</span>
                    </NavLink>
                </Authorized>
            </AuthorizeView>

            <AuthorizeView Roles="Administrador,Secretaria">
                <Authorized>
                    <NavLink class="flex items-center gap-md px-md py-sm rounded-lg hover:bg-surface-container transition-colors text-secondary font-body-md text-body-md"
                             ActiveClass="bg-surface-container text-primary font-bold border-l-4 border-primary" href="finanzas">
                        <span class="material-symbols-outlined">payments</span>
                        <span class="sidebar-label">Finanzas</span>
                    </NavLink>
                </Authorized>
            </AuthorizeView>

            <AuthorizeView Roles="Administrador,Secretaria">
                <Authorized>
                    <NavLink class="flex items-center gap-md px-md py-sm rounded-lg hover:bg-surface-container transition-colors text-secondary font-body-md text-body-md"
                             ActiveClass="bg-surface-container text-primary font-bold border-l-4 border-primary" href="agenda">
                        <span class="material-symbols-outlined">calendar_month</span>
                        <span class="sidebar-label">Agenda</span>
                    </NavLink>
                </Authorized>
            </AuthorizeView>

            <AuthorizeView Roles="Administrador">
                <Authorized>
                    <div class="flex items-center gap-md px-md py-sm rounded-lg hover:bg-surface-container transition-colors text-secondary font-body-md text-body-md cursor-pointer @(EsSeccionConfiguracion ? "bg-surface-container text-primary font-bold border-l-4 border-primary" : "")"
                         @onclick='() => Nav.NavigateTo("configuracion")'>
                        <span class="material-symbols-outlined">settings</span>
                        <span class="sidebar-label">Configuración</span>
                    </div>
                </Authorized>
            </AuthorizeView>
        </nav>

        <div class="p-sm border-t border-outline-variant flex flex-col gap-xs">
            <a class="flex items-center gap-md px-md py-sm rounded-lg hover:bg-surface-container transition-colors text-secondary font-body-md text-body-md" href="#">
                <span class="material-symbols-outlined">help</span>
                <span class="sidebar-label">Soporte</span>
            </a>
            <form method="post" action="account/logout">
                <AntiforgeryToken />
                <button type="submit" class="w-full flex items-center gap-md px-md py-sm rounded-lg hover:bg-surface-container transition-colors text-error font-body-md text-body-md">
                    <span class="material-symbols-outlined">logout</span>
                    <span class="sidebar-label">Cerrar Sesión</span>
                </button>
            </form>
        </div>
    </aside>

    <!-- Main content -->
    <div class="flex-1 flex flex-col min-w-0 @(SidebarColapsado ? "md:ml-sidebar-collapsed" : "md:ml-sidebar-width") h-full bg-surface-container-lowest transition-all duration-200">
        <header class="bg-surface sticky top-0 z-40 border-b border-outline-variant shadow-sm flex justify-between items-center w-full px-lg py-sm h-16">
            <div class="flex items-center relative w-64 md:w-96">
                <span class="material-symbols-outlined absolute left-3 text-on-surface-variant text-lg">search</span>
                <input class="w-full pl-10 pr-4 py-2 bg-surface-container-low border border-outline-variant rounded-lg font-body-md text-body-md text-on-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all"
                       placeholder="Buscar en Taller Manager..." type="text" />
            </div>
            <div class="flex items-center gap-sm">
                <button class="text-on-surface-variant hover:bg-surface-container-low rounded-full p-2 transition-all">
                    <span class="material-symbols-outlined">notifications</span>
                </button>
                <div class="w-px h-8 bg-outline-variant mx-2"></div>
                <AuthorizeView>
                    <Authorized>
                        <div class="flex items-center gap-sm cursor-pointer hover:opacity-80 transition-opacity">
                            <div class="w-8 h-8 rounded-full bg-primary-fixed-dim text-on-primary-container flex items-center justify-center font-headline-sm text-[13px] font-bold">
                                @Iniciales(context.User.Identity?.Name)
                            </div>
                            <span class="font-body-md text-body-md text-on-surface font-semibold hidden md:block">@(context.User.Identity?.Name ?? "Usuario")</span>
                            <span class="material-symbols-outlined text-on-surface-variant">arrow_drop_down</span>
                        </div>
                    </Authorized>
                </AuthorizeView>
            </div>
        </header>

        <main class="flex-1 overflow-y-auto p-lg md:p-xl w-full max-w-max-content-width">
            @Body
        </main>
    </div>
</div>

@code {
    private bool SidebarColapsado = false;

    private void ToggleSidebar() => SidebarColapsado = !SidebarColapsado;

    private static string Iniciales(string? nombre)
    {
        if (string.IsNullOrWhiteSpace(nombre)) return "?";
        var partes = nombre.Split(new[] { '@', '.', ' ' }, StringSplitOptions.RemoveEmptyEntries);
        return partes.Length > 0 ? partes[0][..Math.Min(2, partes[0].Length)].ToUpper() : "?";
    }

    private bool EsSeccionConfiguracion =>
        Nav.Uri.Contains("/configuracion", StringComparison.OrdinalIgnoreCase) ||
        Nav.Uri.Contains("/usuarios", StringComparison.OrdinalIgnoreCase) ||
        Nav.Uri.Contains("/personal", StringComparison.OrdinalIgnoreCase);

    
}
